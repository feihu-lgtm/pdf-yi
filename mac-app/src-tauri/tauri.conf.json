{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF译",
  "version": "0.64.1",
  "identifier": "com.xiaohu.pdfyi",
  "build": {
    "frontendDist": "../../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF译",
        "visible": false,
        "focus": false,
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      },
      {
        "label": "worker",
        "title": "PDF译 后台",
        "url": "worker.html",
        "visible": false,
        "focus": false,
        "backgroundThrottling": "disabled",
        "width": 380,
        "height": 600,
        "skipTaskbar": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true
      },
      {
        "label": "engine-1",
        "title": "PDF译 翻译引擎 1",
        "url": "worker.html?engine=1",
        "visible": false,
        "backgroundThrottling": "disabled",
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "engine-2",
        "title": "PDF译 翻译引擎 2",
        "url": "worker.html?engine=2",
        "visible": false,
        "backgroundThrottling": "disabled",
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "engine-3",
        "title": "PDF译 翻译引擎 3",
        "url": "worker.html?engine=3",
        "visible": false,
        "backgroundThrottling": "disabled",
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "engine-4",
        "title": "PDF译 翻译引擎 4",
        "url": "worker.html?engine=4",
        "visible": false,
        "backgroundThrottling": "disabled",
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "左边原版、右边译文的 PDF 阅读和翻译工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pdfyi"
        ]
      }
    }
  }
}