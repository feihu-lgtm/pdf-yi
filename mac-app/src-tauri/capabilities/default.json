{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PDF译 两个窗口（全量版 main、后台引擎 worker）的权限：打开和存储文件、读写用户目录下的 PDF、接收 pdfyi:// 链接、通知",
  "windows": [
    "main",
    "worker"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "deep-link:default",
    "notification:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "/Volumes/**"
        }
      ]
    }
  ]
}