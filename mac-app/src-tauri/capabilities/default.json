{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PDF译 阅读器、菜单栏面板与隔离翻译引擎：PDF 读写、事件、通知",
  "windows": [
    "main",
    "worker",
    "engine-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "deep-link:default",
    "notification:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "/Volumes/**"
        },
        {
          "path": "/tmp/**"
        },
        {
          "path": "/private/tmp/**"
        }
      ]
    }
  ]
}